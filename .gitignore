!Newerascontinue.zip

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing
coverage/
.nyc_output/
test-results/
*.lcov

# Documentation Build
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Backup Files
*.bak
*.backup
*~

# Cache
.cache/
*.cache

# Future Development Directories
/prototype/
/sandbox/
/experiments/
/drafts/

# Keep important directories
!docs/
!Newerascontinue/

