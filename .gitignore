*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# Build Artifacts
dist/
build/
*.log
*.out

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.key
*.pem

# Secrets and Credentials
secrets.json
credentials.json
*.credential
*secret*
*password*
api-keys.txt

# Database Files
*.db
*.sqlite
*.sqlite3

# Compiled Files
*.com
*.class
*.dll
*.exe
*.o
*.so

# Archives
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip
